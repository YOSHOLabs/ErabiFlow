{
  "name": "erabiflow",
  "version": "0.1.0",
  "description": "長時間動画の見どころ・盛り上がり・不要部分の判断を支援し、編集ソフトへ渡す区間を選ぶWindowsアプリ",
  "private": true,
  "license": "UNLICENSED",
  "author": "YOSHOLabs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOSHOLabs/ErabiFlow.git"
  },
  "bugs": {
    "url": "https://github.com/YOSHOLabs/ErabiFlow/issues"
  },
  "homepage": "https://github.com/YOSHOLabs/ErabiFlow#readme",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.13.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "setup:dev": "pwsh -NoProfile -File scripts/bootstrap_dev.ps1",
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "node --test src/lib/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:release": "npm run build && playwright test --config playwright.release.config.ts",
    "configure:updater": "node scripts/configure_update_endpoint.mjs",
    "build:sidecar": "cmd /c python-sidecar\\build.bat",
    "smoke:desktop-daemon": "node scripts/desktop_daemon_smoke.mjs",
    "audit:dependencies": "pwsh -NoProfile -File scripts/dependency_audit.ps1",
    "audit:licenses": "pwsh -NoProfile -File scripts/dependency_license_audit.ps1",
    "licenses:bundle": ".\\.venv\\Scripts\\python.exe scripts/generate_dependency_license_bundle.py",
    "check:repo": "pwsh -NoProfile -File scripts/public_repo_check.ps1",
    "check:light": "pwsh -NoProfile -File scripts/light_release_check.ps1",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@radix-ui/react-slot": "^1.3.3",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "immer": "^10.1.1",
    "lucide-react": "^1.38.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.5.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "6.4.3"
  }
}
